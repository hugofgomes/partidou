# Copie este arquivo para ".env.deploy" (na raiz do projeto; NÃO vai para o GitHub) e preencha. Nunca cole estes valores no chat.

# Supabase → Connect → Session pooler. Troque [YOUR-PASSWORD] pela senha SEM os colchetes.
# Use uma senha só com letras e números (símbolos como @ # / : quebram a URL).
DATABASE_URL=

# Coolify: URL do painel, token de API (Keys & Tokens, com permissões read, write e deploy) e UUID da aplicação do Partidou.
COOLIFY_URL=
COOLIFY_TOKEN=
COOLIFY_APP_UUID=
